# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase: per-developer project alias. Run `firebase use <project-id>`
# after cloning, or copy .firebaserc.example to .firebaserc and edit it.
.firebaserc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal release notes + release script — never publish to any remote
PUBLISH.md
publish.ps1
test-published.ps1
back-to-main.ps1

# internal owner-only scripts — read the private purchases collection;
# never ship to a buyer's repo
scripts/buyer-stats.mjs
scripts/lookup-purchase.mjs

# internal planning / scoping docs — kept local, not published. The glob
# covers every *_PLAN.md at the repo root (EMAIL_INBOX_V1_PLAN.md,
# SOFTPHONE_V1_PLAN.md, …) so future plans are excluded automatically —
# publish.ps1 snapshots from a git worktree, so untracked = never shipped.
docs/plans/
*_PLAN.md

# temporary worktree used by publish.ps1 — lives one dir above the repo,
# so it's normally invisible to git status; entry kept for intent.
leadstack-pub-tmp/
PAYMENTS_V1_PLAN.md

# Claude Code per-machine permissions. The shared, buyer-facing allowlist is
# .claude/settings.json (tracked). This .local. file is whatever THIS machine
# has clicked "always allow" on -- it can contain absolute local paths, so it
# must never ship to a buyer.
.claude/settings.local.json

# Guided-setup progress file written by the .claude/skills/setup skill.
# Per-install state (which phase the user reached), never secrets.
.leadstack-setup.json
